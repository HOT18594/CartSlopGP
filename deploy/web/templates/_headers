# Cloudflare Pages response headers for the Cart Slop GP Web release.
#
# GENERATED by web_deploy/scripts/stage_release.ps1 from this template - edit
# web_deploy/templates/_headers, not dist/_headers.
#
# Why the payload paths are versioned: Godot's exporter always writes
# index.wasm / index.pck / index.js under fixed names, so a flat deployment
# cannot use `Cache-Control: immutable` without serving a stale 120 MB pack on
# the next release. The stager copies each release under
# /game/<game version>/<build id prefix>/ so every payload URL contains the
# content hash of the build and can be cached for a year. index.html and
# version.json always revalidate.
#
# Cloudflare Pages joins repeated header values with a comma, which corrupts
# Cache-Control, so the narrower rules below DETACH the broad `/game/*` value
# with `! Cache-Control` before setting their own (rules apply in file order).

# --- Security headers on every response ------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# --- Immutable payloads: the build id is in the path -----------------------
/game/*
  Cache-Control: public, max-age=31536000, immutable

# --- The release stamp is a pointer, never cache it ------------------------
/version.json
  Cache-Control: no-store, must-revalidate
  Content-Type: application/json
/release.json
  Cache-Control: no-store, must-revalidate
  Content-Type: application/json
%%RELEASE_PATH%%/version.json
  ! Cache-Control
  Cache-Control: no-store, must-revalidate
  Content-Type: application/json

# --- The HTML entry bootstraps the release; keep it fresh ------------------
%%RELEASE_PATH%%/index.html
  ! Cache-Control
  Cache-Control: no-store, must-revalidate
  Content-Type: text/html; charset=utf-8

# --- Explicit MIME types for the payload -----------------------------------
%%MIME_RULES%%

# --- Cross-origin isolation: only for a threaded (SharedArrayBuffer) build --
%%COOP_COEP%%
