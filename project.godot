; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cart Slop GP"
config/version="0.8.7"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.055, 0.067, 0.141, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
config/icon="res://assets/ui/cart_icon.png"
boot_splash/minimum_display_time=500

[autoload]

GameSettings="*res://scripts/systems/game_settings.gd"
InputSetup="*res://scripts/systems/input_setup.gd"
Music="*res://scripts/systems/music_player.gd"
UpdateChecker="*res://scripts/systems/update_checker.gd"
CursorController="*res://scenes/ui/cursor_controller.tscn"
UiKit="*res://scripts/ui/ui_kit.gd"
MenuNav="*res://scripts/ui/menu_nav.gd"
Network="*res://scripts/net/network.gd"
SceneLoader="*res://scenes/ui/scene_loader.tscn"
WebQuality="*res://scripts/systems/web_quality.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

