[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=1
; Web export overrides (2.0.0). WebGL2 can only run the Compatibility renderer,
; and these make the web build cheap from its very first frame instead of
; waiting for the WebQuality autoload (which still re-applies the full profile
; after every scene load). The desktop values above are untouched: an override
; only takes effect when the "web" feature tag is active. See
; scripts/systems/web_quality.gd.
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/use_debanding.web=false
anti_aliasing/quality/screen_space_aa.web=0
lights_and_shadows/directional_shadow/size.web=256
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
; Web Low-Spec (2.1.0): anisotropic filtering is the most expensive per-pixel
; texture sampler on a weak GPU, and the web profile renders at 0.65x/0.50x
; where it makes no visible difference. Disable it from the very first frame
; instead of waiting for the WebQuality autoload; scripts/systems/web_quality.gd
; re-enforces it (and applies the stricter low tier when selected).
textures/default_filters/anisotropic_filtering_level.web=0
